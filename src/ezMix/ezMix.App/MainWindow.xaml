<Window x:Class="ezMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ezMix.App.Views"
        xmlns:viewModels="clr-namespace:ezMix.App.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="ezMix" Height="640" Width="1100" MinHeight="520" MinWidth="720">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" MinHeight="45" Style="{StaticResource AppBarStyle}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppBarTextStyle}" FontWeight="Bold" FontSize="20" Text="ez"/>
                    <TextBlock Style="{StaticResource AppBarTextStyle}" Foreground="{DynamicResource Brush.Brand.Accent}" FontWeight="Bold" FontSize="20" Text="Mix"/>
                    <TextBlock Style="{StaticResource AppBarTextStyle}" FontSize="20" Text=" - Trộn đề"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Trang chủ" Command="{Binding HomeCommand}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Giới thiệu" Command="{Binding AboutCommand}" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding SubTitle}"
                           Foreground="#BDC3C7"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="240"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" MinHeight="45" Style="{StaticResource AppBarStyle}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="© 2026 - ttkndev" Style="{StaticResource AppBarTextStyle}" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theo dõi:" Style="{StaticResource AppBarTextStyle}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ItemsControl ItemsSource="{Binding SocialItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.OpenFooterActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ActionValue}"
                                        Style="{StaticResource NavButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Liên hệ:" Style="{StaticResource AppBarTextStyle}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <ItemsControl ItemsSource="{Binding ContactItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.OpenFooterActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ActionValue}"
                                        Style="{StaticResource NavButtonStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <ContentControl Content="{Binding CurrentView}"/>

            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource Brush.Overlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverlayMessage, FallbackValue=Đang tải...}" Foreground="{DynamicResource Brush.Text.OnPrimary}" FontSize="16" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="15" Margin="0 12 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
