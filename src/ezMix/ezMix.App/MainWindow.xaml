<Window x:Class="ezMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ezMix.App.Views"
        xmlns:viewmodels="clr-namespace:ezMix.App.ViewModels"
        xmlns:core="clr-namespace:ezMix.App.Assets.Core"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="ezMix" Height="520" Width="900" MinHeight="420" MinWidth="620">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ContactViewModel}">
            <views:ContactView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" MinHeight="50" Style="{StaticResource AppBarStyle}">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource AppBarTextStyle}" FontWeight="Bold" FontSize="18">ez</TextBlock>
                <TextBlock Style="{StaticResource AppBarTextStyle}" Foreground="{DynamicResource Brush.Brand.Accent}" FontWeight="Bold" FontSize="18" Margin="0,0,20,0">Mix</TextBlock>

                <Button Content="🏠 Trang chủ" Command="{Binding HomeCommand}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="ℹ️ Giới thiệu" Command="{Binding ContactCommand}" Style="{StaticResource NavButtonStyle}"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" MinHeight="50" Style="{StaticResource AppBarStyle}">
            <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon bản quyền -->
                <TextBlock Text="{x:Static core:AppContactInfo.Copyright}"
                   Style="{StaticResource AppBarTextStyle}"
                   FontSize="14" Margin="5,0,8,0"/>

                <!-- Social buttons -->
                <Button Content="{x:Static core:AppContactInfo.Facebook}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="{x:Static core:AppContactInfo.Zalo}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="{x:Static core:AppContactInfo.Youtube}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="{x:Static core:AppContactInfo.Website}" Style="{StaticResource NavButtonStyle}"/>

                <!-- Thêm SĐT và Email -->
                <Button Content="{x:Static core:AppContactInfo.Phone}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="{x:Static core:AppContactInfo.Email}" Style="{StaticResource NavButtonStyle}"/>
            </WrapPanel>
        </Border>

        <Grid>
            <ContentControl Content="{Binding CurrentView}"/>

            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                  Background="{DynamicResource Brush.Overlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverlayMessage, FallbackValue=Đang tải...}"
                               Foreground="{DynamicResource Brush.Text.OnPrimary}"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="15"
                                 Margin="0 12 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
