<Window x:Class="ezMix.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ezMix.App.Views"
        xmlns:viewModels="clr-namespace:ezMix.App.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="ezMix"
        Height="640" Width="1100"
        MinHeight="560" MinWidth="760"
        Background="{DynamicResource Brush.Background.App}">

    <!--
    ╔══════════════════════════════════════════════════════════╗
    ║                   MAIN WINDOW                           ║
    ║  Layout: DockPanel                                      ║
    ║    ├── [Top]    Header / AppBar                         ║
    ║    ├── [Bottom] Footer / AppBar                         ║
    ║    └── [Fill]   Content area (view + loading overlay)   ║
    ╚══════════════════════════════════════════════════════════╝
    -->

    <!-- DataTemplate: ánh xạ ViewModel → View tương ứng -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ══════════════════════════════════════════
             HEADER (AppBar trên)
             Cột 1: Logo | Cột 2: Nav | Cột 3: Actions
        ══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource AppBarStyle}"
                Padding="24,0"
                Height="56">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Logo -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nav links (căn giữa) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Actions (bên phải) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Logo ── -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,32,0">
                    <!-- "ez" thường + "Mix" accent -->
                    <TextBlock Text="ez"
                               Style="{StaticResource AppBarTextStyle}"
                               FontWeight="Bold"
                               FontSize="20"/>
                    <TextBlock Text="Mix"
                               Style="{StaticResource AppBarTextStyle}"
                               Foreground="{DynamicResource Brush.Brand.Accent}"
                               FontWeight="Bold"
                               FontSize="20"/>
                    <!-- Separator nhỏ giữa logo và slogan -->
                    <Border Width="1" Height="16"
                            Background="{DynamicResource Brush.Border.Default}"
                            Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Trộn đề thi"
                               Style="{StaticResource AppBarTextStyle}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ── Nav links (căn giữa) ── -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <!-- Tag binding = IsHomeActive → trigger active state trong NavButtonStyle -->
                    <Button Content="Trang chủ"
                            Command="{Binding HomeCommand}"
                            Tag="{Binding IsHomeActive}"
                            Style="{StaticResource NavButtonStyle}"/>
                    <!-- Disabled + tooltip vì chưa ra mắt -->
                    <Button Content="Trộn đề"
                            IsEnabled="False"
                            ToolTip="Sắp ra mắt"
                            Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="Giới thiệu"
                            Command="{Binding AboutCommand}"
                            Tag="{Binding IsAboutActive}"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- ── Actions (bên phải) ── -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <!-- Nút đổi theme: hiện icon tương ứng dark/light -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            ToolTip="Đổi giao diện sáng / tối"
                            Margin="0,0,4,0">
                        <!-- Dùng TextBlock để bind text động theo IsDarkMode -->
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Setter Property="Text" Value="☀ Sáng"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                            <Setter Property="Text" Value="🌙 Tối"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Subtitle / version info hiển thị nhỏ bên phải -->
                    <TextBlock Text="{Binding SubTitle}"
                               Style="{StaticResource AppBarTextStyle}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             FOOTER (AppBar dưới)
             Hàng 1: Copyright
             Hàng 2: Social links | Contact links
        ══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource AppBarFooterStyle}"
                Padding="24,10">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Copyright -->
                <TextBlock Text="© 2026 · ttkndev"
                           Style="{StaticResource AppBarTextStyle}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- Social + Contact links -->
                <WrapPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="900">

                    <!-- Nhóm: Theo dõi -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <TextBlock Text="Theo dõi:"
                                   Style="{StaticResource AppBarTextStyle}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding SocialItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.OpenFooterActionCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ActionValue}"
                                            Style="{StaticResource NavButtonStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Divider dọc giữa 2 nhóm -->
                    <Border Width="1" Height="16"
                            Background="{DynamicResource Brush.Border.Default}"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0"/>

                    <!-- Nhóm: Liên hệ -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Liên hệ:"
                                   Style="{StaticResource AppBarTextStyle}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding ContactItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}"
                                            Command="{Binding DataContext.OpenFooterActionCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ActionValue}"
                                            Style="{StaticResource NavButtonStyle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════
             CONTENT AREA (phần còn lại giữa header/footer)
             Lớp 1: ContentControl → render View hiện tại
             Lớp 2: Loading overlay → hiện khi IsBusy = True
        ══════════════════════════════════════════ -->
        <Grid>

            <!-- View hiện tại (Home / Trộn đề / Giới thiệu) -->
            <ContentControl Content="{Binding CurrentView}"/>

            <!-- Loading overlay: phủ toàn bộ khi IsBusy = True -->
            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                  Background="{DynamicResource Brush.Overlay}">
                <Border Style="{StaticResource Card.Elevated}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="36,28"
                        MinWidth="220">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Thông báo loading -->
                        <TextBlock Text="{Binding OverlayMessage, FallbackValue=Đang tải...}"
                                   Style="{StaticResource Text.H3}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <!-- ProgressBar indeterminate dùng style mới từ Controls.xaml -->
                        <ProgressBar IsIndeterminate="True"
                                     Width="180"
                                     Height="5"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

    </DockPanel>
</Window>
