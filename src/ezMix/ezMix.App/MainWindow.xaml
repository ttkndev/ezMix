<Window x:Class="ezMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ezMix.App.Views"
        xmlns:viewModels="clr-namespace:ezMix.App.ViewModels"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="ezMix" Height="600" Width="1000" MinHeight="480" MinWidth="640">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
            <views:AboutView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" MinHeight="50" Style="{StaticResource AppBarStyle}">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource AppBarTextStyle}" FontWeight="Bold" FontSize="18">ez</TextBlock>
                <TextBlock Style="{StaticResource AppBarTextStyle}" Foreground="{DynamicResource Brush.Brand.Accent}" FontWeight="Bold" FontSize="18" Margin="0,0,20,0">Mix</TextBlock>

                <Button Content="🏠 Trang chủ" Command="{Binding HomeCommand}" Style="{StaticResource NavButtonStyle}"/>
                <Button Content="ℹ️ Giới thiệu" Command="{Binding AboutCommand}" Style="{StaticResource NavButtonStyle}"/>

                <TextBlock Text="{Binding SubTitle, FallbackValue=Tiêu đề phụ}"
                           Foreground="#BDC3C7"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="32 0 0 0"/>
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" MinHeight="50" Style="{StaticResource AppBarStyle}">
            <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Icon bản quyền -->
                <TextBlock Text="© 2026 - ttkndev"
                   Style="{StaticResource AppBarTextStyle}"
                   FontSize="14" Margin="5,0,8,0"/>

                <ItemsControl ItemsSource="{Binding FooterItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.OpenFooterActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding ActionValue}"
                                    Style="{StaticResource NavButtonStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </Border>

        <Grid>
            <ContentControl Content="{Binding CurrentView}"/>

            <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                  Background="{DynamicResource Brush.Overlay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverlayMessage, FallbackValue=Đang tải...}"
                               Foreground="{DynamicResource Brush.Text.OnPrimary}"
                               FontSize="16"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="15"
                                 Margin="0 12 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
