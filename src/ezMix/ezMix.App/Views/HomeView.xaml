<UserControl x:Class="ezMix.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardPanelStyle}" Padding="26" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="74" Height="74" CornerRadius="16" Background="#E6F0FF" VerticalAlignment="Top">
                        <TextBlock Text="🧩" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="ezMix — Trộn đề nhanh, chuẩn và đẹp"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   FontSize="32"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   TextWrapping="Wrap">
                            Giúp giáo viên chuẩn hóa và trộn đề kiểm tra chỉ trong vài bước,
                            đảm bảo chính xác, nhất quán và dễ rà soát trước khi in hoặc xuất file.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Định dạng đề được hỗ trợ"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="26"
                               Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource CardPanelStyle}" Background="#F7FAFF" Margin="0,0,10,10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✅ Trắc nghiệm nhiều lựa chọn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="A/B/C/D rõ ràng, tự nhận diện đáp án và giữ định dạng nhất quán." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F7FAFF" Margin="10,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✔️ Trắc nghiệm Đúng–Sai" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Nhận diện các phát biểu theo từng ý, hỗ trợ đáp án dạng tổ hợp đúng/sai." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F7FAFF" Margin="0,10,10,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✍️ Trắc nghiệm trả lời ngắn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Phù hợp với đáp án ngắn (ví dụ mã số, kết quả rút gọn), dễ đối chiếu khi chấm." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F7FAFF" Margin="10,10,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🧾 Tự luận" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Giữ cấu trúc đề tự luận và hướng dẫn giải để đảm bảo nội dung đầy đủ khi trộn." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Gợi ý sử dụng hiệu quả"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="22"
                               Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 1: Chuẩn hóa nội dung đề theo mẫu định dạng." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 2: Kiểm tra nhanh vùng cảnh báo trước khi trộn." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 3: Trộn đề và xuất bản in với bố cục nhất quán." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,12,0,0"
                               Text="Lưu ý và thông điệp từ tác giả đã được chuyển sang trang Giới thiệu (About) để HomeView tập trung vào trải nghiệm sử dụng."/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
