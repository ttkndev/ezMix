<UserControl x:Class="ezMix.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Style="{StaticResource PageContentGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardPanelStyle}" Padding="26" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="74" Height="74" CornerRadius="16" Background="#E6F0FF" VerticalAlignment="Top">
                        <TextBlock Text="🧩" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="ezMix — Trộn đề nhanh, chuẩn và đẹp"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   FontSize="32"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   TextWrapping="Wrap"
                                   Text="Giúp bạn chuẩn hóa và trộn đề kiểm tra nhanh chóng, chính xác, bảo mật và hoàn toàn miễn phí."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Mẫu trình bày đề chuẩn hóa"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="26"
                               Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource CardPanelStyle}" Background="#F8FAFF" Margin="0,0,10,10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✅ Trắc nghiệm Nhiều lựa chọn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="A. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="B. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="C." TextDecorations="Underline"/>
                                    <Run Text=" Nội dung đáp án."/>
                                </TextBlock>
                                <TextBlock Text="D. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="📝 Đáp án đúng: C" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F8FAFF" Margin="10,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✔️ Trắc nghiệm Đúng–Sai" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="a)" TextDecorations="Underline"/>
                                    <Run Text=" Nội dung phát biểu"/>
                                </TextBlock>
                                <TextBlock Text="b) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="c)" TextDecorations="Underline"/>
                                    <Run Text=" Nội dung phát biểu"/>
                                </TextBlock>
                                <TextBlock Text="d) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="📝 Phát biểu đúng (a, c), sai (b, d)" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F8FAFF" Margin="0,10,10,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="✍️ Trắc nghiệm Trả lời ngắn" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="A. 0000" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="📝 Đáp án: '0000'" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Text="Số lượng kí tự của đáp án ≤ 4" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanelStyle}" Background="#F8FAFF" Margin="10,10,0,0" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🧾 Tự luận" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                <TextBlock Text="A. Hướng dẫn giải" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="📝 Đáp án: 'Hướng dẫn giải'" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <TextBlock Text="Số lượng kí tự của đáp án ≥ 5" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0"/>
                                <TextBlock Text="Lưu ý: Nếu câu tự luận có nhiều ý hỏi thì bắt đầu bằng các ý hỏi là a/ b/ c/... để nhận dạng tốt nhất."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{DynamicResource Brush.Brand.Primary}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}">
                <StackPanel>
                    <TextBlock Text="Gợi ý sử dụng hiệu quả"
                               Style="{StaticResource SectionTitleTextStyle}"
                               FontSize="22"
                               Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 1: Chuẩn hóa nội dung đề theo mẫu định dạng." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 2: Kiểm tra nhanh vùng cảnh báo trước khi trộn." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="• Bước 3: Trộn đề và xuất bản in với bố cục nhất quán." Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,12,0,0"
                               Text="Lưu ý và thông điệp từ tác giả đã được chuyển sang trang Giới thiệu (About) để HomeView tập trung vào trải nghiệm sử dụng."/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
