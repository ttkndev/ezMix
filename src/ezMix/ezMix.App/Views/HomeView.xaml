<UserControl x:Class="ezMix.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d" d:DesignHeight="960" d:DesignWidth="1366">
    <Grid Background="{DynamicResource Brush.Surface.Primary}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20" MaxWidth="1200" HorizontalAlignment="Center">

                <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="80" Height="80" Background="{DynamicResource Brush.Brand.Accent}" CornerRadius="20">
                            <TextBlock Text="🧩" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Phần mềm trộn đề ezMix" Style="{StaticResource PageTitleTextStyle}"/>
                            <TextBlock Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0">
                                <Run Text="Chuẩn hóa và trộn đề thi tự động."/>
                                <Run Text="Chính xác - Bảo mật - Miễn phí." FontWeight="SemiBold" Foreground="{DynamicResource Brush.Brand.Accent}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Hướng dẫn định dạng câu hỏi" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,20"/>

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,10,20" BorderLeftBrush="{DynamicResource Brush.Brand.Accent}" BorderLeftThickness="4">
                        <StackPanel>
                            <TextBlock Text="✅ Trắc nghiệm Nhiều lựa chọn" FontWeight="Bold" Foreground="{DynamicResource Brush.Brand.Accent}" Margin="0,0,0,12"/>
                            <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="A. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="B. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="C. Nội dung đáp án." Style="{StaticResource BodyTextStyle}" TextDecorations="Underline" FontWeight="SemiBold"/>
                            <TextBlock Text="D. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanelStyle}" Margin="10,0,0,20" BorderLeftBrush="{DynamicResource Brush.Brand.Accent}" BorderLeftThickness="4">
                        <StackPanel>
                            <TextBlock Text="✔️ Trắc nghiệm Đúng–Sai" FontWeight="Bold" Foreground="{DynamicResource Brush.Brand.Accent}" Margin="0,0,0,12"/>
                            <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                            <TextBlock Text="a) Nội dung phát biểu" TextDecorations="Underline" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="b) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="c) Nội dung phát biểu" TextDecorations="Underline" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Text="d) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>