<UserControl x:Class="ezMix.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="960" d:DesignWidth="1366">
    <Grid Background="{DynamicResource Brush.Background.Page}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
            <Grid Style="{StaticResource PageContentGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardPanelStyle}" Padding="32" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="72" Height="72"
                                Background="#EAF2FF"
                                CornerRadius="20"
                                VerticalAlignment="Top">
                            <TextBlock Text="🧩"
                                       FontSize="34"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                       FontSize="32"
                                       TextWrapping="Wrap">
                                <Run Text="Phần mềm trộn đề"/>
                            </TextBlock>

                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap">
                                Giúp bạn
                                <Run Text=" chuẩn hóa" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <Run Text=" và"/>
                                <Run Text=" trộn đề" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <Run Text=" kiểm tra nhanh chóng, chính xác, bảo mật và hoàn toàn miễn phí."/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Hướng dẫn định dạng câu hỏi"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   FontSize="24"
                                   Margin="0,0,0,16"/>

                        <UniformGrid Columns="2">
                            <Border Background="#F6F9FF" CornerRadius="14" BorderBrush="#DCE7FF" BorderThickness="1" Padding="18" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="✅ Trắc nghiệm Nhiều lựa chọn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="A. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="B. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Style="{StaticResource BodyTextStyle}">
                                        <Run Text="C." TextDecorations="Underline"/>
                                        <Run Text=" Nội dung đáp án."/>
                                    </TextBlock>
                                    <TextBlock Text="D. Nội dung đáp án." Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="📝 Đáp án đúng: C" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F6F9FF" CornerRadius="14" BorderBrush="#DCE7FF" BorderThickness="1" Padding="18" Margin="10,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="✔️ Trắc nghiệm Đúng–Sai" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,5"/>
                                    <TextBlock Style="{StaticResource BodyTextStyle}">
                                        <Run Text="a)" TextDecorations="Underline"/>
                                        <Run Text=" Nội dung phát biểu"/>
                                    </TextBlock>
                                    <TextBlock Text="b) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Style="{StaticResource BodyTextStyle}">
                                        <Run Text="c)" TextDecorations="Underline"/>
                                        <Run Text=" Nội dung phát biểu"/>
                                    </TextBlock>
                                    <TextBlock Text="d) Nội dung phát biểu" Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="📝 Phát biểu đúng (a, c), sai (b, d)" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F6F9FF" CornerRadius="14" BorderBrush="#DCE7FF" BorderThickness="1" Padding="18" Margin="0,10,10,0">
                                <StackPanel>
                                    <TextBlock Text="✍️ Trắc nghiệm Trả lời ngắn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="A. 0000" Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="📝 Đáp án: '0000'" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="Số lượng kí tự của đáp án ≤ 4" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F6F9FF" CornerRadius="14" BorderBrush="#DCE7FF" BorderThickness="1" Padding="18" Margin="10,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="🧾 Tự luận" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Câu 1: Nội dung câu hỏi?" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="A. Hướng dẫn giải" Style="{StaticResource BodyTextStyle}"/>
                                    <TextBlock Text="📝 Đáp án: 'Hướng dẫn giải'" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="Số lượng kí tự của đáp án ≥ 5" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Lưu ý: Nếu câu tự luận có nhiều ý hỏi thì bắt đầu bằng các ý hỏi là a/ b/ c/... để nhận dạng tốt nhất."
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#F8E5A5" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="Center"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="#7A5A00"
                               Text="⚠️ Hiện chức năng Chuẩn hóa nhận dạng các kí hiệu A., B., C., D. là kí hiệu đáp án. Bạn nên rà soát và điều chỉnh theo cảnh báo nếu trong nội dung có thêm các kí hiệu này."/>
                </Border>

                <Border Grid.Row="3" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="16">
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="💙 Tác giả luôn nỗ lực để mang lại trải nghiệm tốt, nếu có sai sót rất mong nhận được góp ý từ bạn qua nhóm hỗ trợ. Sự đóng góp của bạn là động lực để ezMix ngày càng hoàn thiện và hỗ trợ tốt nhất cho cộng đồng. 💙"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
