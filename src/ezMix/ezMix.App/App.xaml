<Application x:Class="ezMix.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ezMix.App"
             xmlns:conv="clr-namespace:ezMix.App.Assets.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Assets/Styles/Brushes.xaml"/>
                <ResourceDictionary Source="Assets/Styles/SemanticTokens.xaml"/>
                <ResourceDictionary Source="Assets/Styles/NavButtonStyle.xaml"/>
                <ResourceDictionary Source="Assets/Styles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="Assets/Styles/LayoutStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
