<Application x:Class="ezMix.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <!--
    ╔══════════════════════════════════════════════════════════╗
    ║                    APP.XAML                             ║
    ║  Mô tả: Điểm merge toàn bộ style vào ứng dụng.         ║
    ║  Style được load theo thứ tự:                           ║
    ║    1. Colors.xaml    (được merge bởi Theme*.xaml)       ║
    ║    2. ThemeDark.xaml HOẶC ThemeLight.xaml (load động)   ║
    ║    3. Typography.xaml                                   ║
    ║    4. Controls.xaml                                     ║
    ║    5. Buttons.xaml                                      ║
    ║    6. Layout.xaml                                       ║
    ║    7. Converters.xaml                                   ║
    ╚══════════════════════════════════════════════════════════╝
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!--
                ══════════════════════════════════════════
                BƯỚC 1: THEME (Chọn 1 trong 2)
                Khi khởi động, load theme mặc định.
                ThemeService.cs sẽ swap file này lúc runtime
                để đổi theme không cần restart app.

                Mặc định: Dark Mode
                Để đổi sang Light: thay ThemeDark → ThemeLight
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/ThemeDark.xaml"/>
                <!-- <ResourceDictionary Source="Assets/Styles/ThemeLight.xaml"/> -->

                <!--
                ══════════════════════════════════════════
                BƯỚC 2: TYPOGRAPHY (Chữ viết)
                Load sau theme vì dùng {DynamicResource Brush.*}
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/Typography.xaml"/>

                <!--
                ══════════════════════════════════════════
                BƯỚC 3: CONTROLS (Form controls)
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/Controls.xaml"/>

                <!--
                ══════════════════════════════════════════
                BƯỚC 4: BUTTONS (Nút bấm)
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/Buttons.xaml"/>

                <!--
                ══════════════════════════════════════════
                BƯỚC 5: LAYOUT (Card, Panel, AppBar)
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/Layout.xaml"/>

                <!--
                ══════════════════════════════════════════
                BƯỚC 6: CONVERTERS (Value converters)
                ══════════════════════════════════════════
                -->
                <ResourceDictionary Source="Assets/Styles/Converters.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!--
            ════════════════════════════════════════
            STYLE GLOBAL (áp lên tất cả control cùng loại)
            Đặt ở đây để override sau khi load xong tất cả style files.
            ════════════════════════════════════════
            -->

            <!-- Tất cả TextBlock dùng base style mặc định -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>

            <!-- Background mặc định của Window -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.App}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
                <Setter Property="FontSize"   Value="14"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>

</Application>
