<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- STYLE: NÚT BẤM (Button) File: Assets/Styles/Buttons.xaml Mô tả: Định nghĩa toàn bộ variant... -->

    <!-- NÚT CHÍNH (Primary) Dùng cho: Xác nhận, Tạo mới, Hành động quan trọng. -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Background"       Value="{DynamicResource Brush.Brand.Primary}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.OnPrimary}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="20,10"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <!-- Hiệu ứng sáng bên trong (inner glow). -->
                        <Border.Effect>
                            <DropShadowEffect Color="#5B6CF9" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: sáng hơn. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Brand.PrimaryHover}"/>
                        </Trigger>
                        <!-- Pressed: tối hơn, hơi thu nhỏ. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Brand.PrimaryPressed}"/>
                            <Setter TargetName="PART_Border" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Disabled: mờ đi. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NÚT PHỤ (Secondary) Dùng cho: Hủy, Quay lại, Hành động ít quan trọng. -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness"  Value="1.5"/>
        <Setter Property="Padding"          Value="18,9"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="FontWeight"       Value="Medium"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Hover}"/>
                            <Setter TargetName="PART_Border" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Brand.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NÚT GHOST (Transparent) Dùng cho: Điều hướng, hành động phụ, nút trong list Đây cũng là Na... -->
    <Style x:Key="Button.Ghost" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="12,7"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Hover}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Selected}"/>
                        </Trigger>
                        <!-- Trạng thái "đang active" - dùng Tag để truyền boolean. -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Brand.Primary}"/>
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Selected}"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alias: NavButtonStyle → Button.Ghost (dùng trên AppBar). -->
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource Button.Ghost}"/>

    <!-- NÚT NGUY HIỂM (Danger) Dùng cho: Xóa, Hủy bỏ dữ liệu, Thao tác không thể hoàn tác. -->
    <Style x:Key="Button.Danger" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Status.Error}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Status.Error}"/>
        <Setter Property="BorderThickness"  Value="1.5"/>
        <Setter Property="Padding"          Value="18,9"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="FontWeight"       Value="Medium"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover: nền đỏ nhạt. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="#1AEF4444"/>
                            <Setter Property="Foreground"   Value="{DynamicResource Brush.Status.Error}"/>
                        </Trigger>
                        <!-- Pressed: đậm hơn. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="#33EF4444"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NÚT ICON (Hình vuông, chỉ icon) Dùng cho: Nút đóng, nút cài đặt, nút trợ giúp... -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width"    Value="36"/>
        <Setter Property="Height"   Value="36"/>
        <Setter Property="Padding"  Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Border" Property="Background"
                                    Value="{DynamicResource Brush.Background.Selected}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- NÚT LINK (Text thuần, giống hyperlink) Dùng cho: Link nội dung, điều hướng inline. -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Link}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="2,0"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="PART_Text"
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Text" Property="TextDecorations"
                                    Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
