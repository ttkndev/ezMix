<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="AppBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Brand.Primary}"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <Style x:Key="AppBarTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
