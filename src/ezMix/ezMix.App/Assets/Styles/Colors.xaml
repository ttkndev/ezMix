<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Surface.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Overlay">#AA0F172A</Color>

    <Color x:Key="Color.Brand.Primary">#0F172A</Color>
    <Color x:Key="Color.Brand.Accent">#2563EB</Color>
    <Color x:Key="Color.Brand.Hover">#1E293B</Color>
    <Color x:Key="Color.Text.Base">#1E293B</Color>
    <Color x:Key="Color.Text.Muted">#64748B</Color>
    <Color x:Key="Color.Text.OnPrimary">#FFFFFF</Color>

    <Color x:Key="Color.Status.Info">#E0F2FE</Color>
    <Color x:Key="Color.Status.InfoText">#0369A1</Color>
    <Color x:Key="Color.Status.Warning">#FEF3C7</Color>
    <Color x:Key="Color.Status.WarningText">#92400E</Color>

    <Color x:Key="Color.Border.Subtle">#E2E8F0</Color>
