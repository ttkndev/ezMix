<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Bảng màu gốc (foundation palette).
        Các màu này KHÔNG bind trực tiếp vào UI, mà đi qua LightTheme/DarkTheme
        để có thể thay đổi giao diện đồng bộ cho cả 2 chế độ.
    -->
    <Color x:Key="Palette.Blue.700">#1D4ED8</Color>
    <Color x:Key="Palette.Blue.600">#2563EB</Color>

    <Color x:Key="Palette.Slate.900">#0F172A</Color>
    <Color x:Key="Palette.Slate.800">#1E293B</Color>
    <Color x:Key="Palette.Slate.700">#334155</Color>
    <Color x:Key="Palette.Slate.600">#475569</Color>
    <Color x:Key="Palette.Slate.500">#64748B</Color>
    <Color x:Key="Palette.Slate.400">#94A3B8</Color>
    <Color x:Key="Palette.Slate.200">#E2E8F0</Color>
    <Color x:Key="Palette.Slate.100">#F1F5F9</Color>
    <Color x:Key="Palette.Slate.50">#F8FAFC</Color>

    <Color x:Key="Palette.White">#FFFFFF</Color>
    <Color x:Key="Palette.Black">#000000</Color>

    <Color x:Key="Palette.Amber.100">#FEF3C7</Color>
    <Color x:Key="Palette.Amber.800">#92400E</Color>
</ResourceDictionary>
