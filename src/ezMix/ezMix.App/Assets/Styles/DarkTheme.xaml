<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Override token khi dùng DarkMode -->
    <Color x:Key="Color.Surface.Primary">{DynamicResource Palette.Slate.900}</Color>
    <Color x:Key="Color.Surface.Card">{DynamicResource Palette.Slate.800}</Color>
    <Color x:Key="Color.Surface.Header">{DynamicResource Palette.Slate.800}</Color>

    <Color x:Key="Color.Text.Base">{DynamicResource Palette.Slate.100}</Color>
    <Color x:Key="Color.Text.Muted">{DynamicResource Palette.Slate.400}</Color>
    <Color x:Key="Color.Text.OnPrimary">{DynamicResource Palette.White}</Color>

    <Color x:Key="Color.Border.Subtle">{DynamicResource Palette.Slate.700}</Color>
    <Color x:Key="Color.Brand.Primary">{DynamicResource Palette.Slate.100}</Color>
    <Color x:Key="Color.Brand.Accent">{DynamicResource Palette.Blue.600}</Color>
    <Color x:Key="Color.Brand.Hover">#332563EB</Color>
</ResourceDictionary>
