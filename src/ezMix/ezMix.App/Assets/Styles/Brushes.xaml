<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{DynamicResource Color.Surface.Primary}"/>
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{DynamicResource Color.Surface.Card}"/>
    <SolidColorBrush x:Key="Brush.Surface.Header" Color="{DynamicResource Color.Surface.Header}"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="{DynamicResource Color.Surface.Overlay}"/>

    <SolidColorBrush x:Key="Brush.Text.Base" Color="{DynamicResource Color.Text.Base}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{DynamicResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{DynamicResource Color.Text.OnPrimary}"/>

    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="{DynamicResource Color.Brand.Primary}"/>
    <SolidColorBrush x:Key="Brush.Brand.Accent" Color="{DynamicResource Color.Brand.Accent}"/>
    <SolidColorBrush x:Key="Brush.Brand.Hover" Color="{DynamicResource Color.Brand.Hover}"/>

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{DynamicResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{DynamicResource Color.Status.Warning}"/>
    <SolidColorBrush x:Key="Brush.Status.WarningText" Color="{DynamicResource Color.Status.WarningText}"/>
</ResourceDictionary>
