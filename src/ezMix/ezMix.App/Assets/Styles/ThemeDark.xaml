<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- THEME: DARK MODE File: Assets/Styles/ThemeDark.xaml Mô tả: Override toàn bộ brush theo nền... -->

    <!-- Merge bảng màu gốc và màu thương hiệu dùng chung. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- NỀN (Background). -->
    <!-- Nền toàn ứng dụng. -->
    <SolidColorBrush x:Key="Brush.Background.App"       Color="#0F1117"/>
    <!-- Nền panel, sidebar, container. -->
    <SolidColorBrush x:Key="Brush.Background.Surface"   Color="#1A1D27"/>
    <!-- Nền card thông thường. -->
    <SolidColorBrush x:Key="Brush.Background.Card"      Color="#222636"/>
    <!-- Nền card nổi, dropdown, tooltip. -->
    <SolidColorBrush x:Key="Brush.Background.Elevated"  Color="#2A2F45"/>
    <!-- Nền thanh AppBar (header/footer). -->
    <SolidColorBrush x:Key="Brush.Background.AppBar"    Color="#13161F"/>
    <!-- Nền input (textbox, combobox). -->
    <SolidColorBrush x:Key="Brush.Background.Input"     Color="#1E2130"/>
    <!-- Nền hover nhẹ cho item danh sách. -->
    <SolidColorBrush x:Key="Brush.Background.Hover"     Color="#2A2F45"/>
    <!-- Nền khi được chọn (selected). -->
    <SolidColorBrush x:Key="Brush.Background.Selected"  Color="#3A3F5C"/>

    <!-- CHỮ (Text). -->
    <!-- Chữ chính, nội dung quan trọng. -->
    <SolidColorBrush x:Key="Brush.Text.Primary"         Color="#E8EAFF"/>
    <!-- Chữ phụ, nhãn thứ cấp. -->
    <SolidColorBrush x:Key="Brush.Text.Secondary"       Color="#B0B8D8"/>
    <!-- Chữ mờ, placeholder, hint. -->
    <SolidColorBrush x:Key="Brush.Text.Muted"           Color="#6B7599"/>
    <!-- Chữ bị vô hiệu hóa (disabled). -->
    <SolidColorBrush x:Key="Brush.Text.Disabled"        Color="#40455C"/>
    <!-- Chữ trên nền màu thương hiệu (primary button, appbar accent). -->
    <SolidColorBrush x:Key="Brush.Text.OnPrimary"       Color="#FFFFFF"/>
    <!-- Chữ link hoặc nổi bật nhẹ. -->
    <SolidColorBrush x:Key="Brush.Text.Link"            Color="#7C8DFF"/>

    <!-- VIỀN (Border). -->
    <!-- Viền mặc định (card, input lúc bình thường). -->
    <SolidColorBrush x:Key="Brush.Border.Default"       Color="#2E3450"/>
    <!-- Viền khi focus (input đang nhập). -->
    <SolidColorBrush x:Key="Brush.Border.Focus"         Color="#5B6CF9"/>
    <!-- Viền khi lỗi validation. -->
    <SolidColorBrush x:Key="Brush.Border.Error"         Color="#EF4444"/>
    <!-- Viền subtle, phân cách section. -->
    <SolidColorBrush x:Key="Brush.Border.Subtle"        Color="#1E2235"/>

    <!-- LỚP PHỦ (Overlay). -->
    <!-- Nền mờ khi hiện loading spinner hoặc dialog. -->
    <SolidColorBrush x:Key="Brush.Overlay"              Color="#0A0C14" Opacity="0.75"/>

    <!-- BÓNG ĐỔ (Shadow - dùng với Effect). -->
    <!-- Màu bóng đổ cho card/panel. -->
    <Color x:Key="Color.Shadow">#000000</Color>

    <!-- SCROLLBAR. -->
    <SolidColorBrush x:Key="Brush.ScrollBar.Track"      Color="#1A1D27"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb"      Color="#2E3450"/>
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#4A5075"/>

</ResourceDictionary>
