<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ╔══════════════════════════════════════════════════════════╗
    ║              STYLE: CONTROLS (Form Controls)            ║
    ║  File: Assets/Styles/Controls.xaml                      ║
    ║  Mô tả: Style cho các control nhập liệu & hiển thị.    ║
    ╚══════════════════════════════════════════════════════════╝

    NỘI DUNG:
    - TextBox          → Ô nhập văn bản (có placeholder qua Tag)
    - PasswordBox      → Ô nhập mật khẩu
    - ComboBox         → Danh sách thả xuống
    - CheckBox         → Ô tích chọn
    - RadioButton      → Nút chọn một
    - ProgressBar      → Thanh tiến độ (determinate + indeterminate)
    - ScrollBar        → Thanh cuộn tùy chỉnh
    - Separator        → Đường phân cách
    -->

    <!-- ════════════════════════
         TEXTBOX
    ════════════════════════ -->
    <Style x:Key="Input.TextBox" TargetType="TextBox">
        <Setter Property="Background"           Value="{DynamicResource Brush.Background.Input}"/>
        <Setter Property="Foreground"           Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush"          Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness"      Value="1.5"/>
        <Setter Property="Padding"              Value="12,9"/>
        <Setter Property="FontSize"             Value="14"/>
        <Setter Property="CaretBrush"           Value="{DynamicResource Brush.Brand.Primary}"/>
        <Setter Property="SelectionBrush"       Value="{DynamicResource Brush.Brand.Primary}"/>
        <Setter Property="SelectionOpacity"     Value="0.35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid>
                            <!-- Placeholder text (hiển thị khi textbox rỗng) -->
                            <!-- Lưu ý: Dùng Tag để truyền placeholder text từ XAML -->
                            <TextBlock x:Name="PART_Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hiện placeholder khi text rỗng và không focus -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- Focus: đổi viền thành màu brand -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Border.Focus}"/>
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <!-- Hover: viền sáng hơn chút -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Brand.Accent}"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox đa dòng (TextArea) -->
    <Style x:Key="Input.TextArea" TargetType="TextBox" BasedOn="{StaticResource Input.TextBox}">
        <Setter Property="AcceptsReturn"        Value="True"/>
        <Setter Property="TextWrapping"         Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="MinHeight"            Value="80"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding"              Value="12"/>
    </Style>

    <!-- ════════════════════════
         COMBOBOX
    ════════════════════════ -->
    <Style x:Key="Input.ComboBox" TargetType="ComboBox">
        <Setter Property="Background"       Value="{DynamicResource Brush.Background.Input}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness"  Value="1.5"/>
        <Setter Property="Padding"          Value="12,9"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Height"           Value="40"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <!-- Style cho từng item trong dropdown -->
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background"   Value="Transparent"/>
                    <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Primary}"/>
                    <Setter Property="Padding"      Value="12,8"/>
                    <Setter Property="FontSize"     Value="14"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Selected}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Brand.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════
         CHECKBOX
    ════════════════════════ -->
    <Style x:Key="Input.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground"       Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hộp tick -->
                        <Border x:Name="PART_Box"
                                Width="18" Height="18"
                                Background="{DynamicResource Brush.Background.Input}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1.5"
                                CornerRadius="4"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <!-- Dấu tick (ẩn mặc định) -->
                            <Path x:Name="PART_Check"
                                  Data="M2,9 L7,14 L16,4"
                                  Stroke="{DynamicResource Brush.Text.OnPrimary}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Khi được tick -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Box" Property="Background"
                                    Value="{DynamicResource Brush.Brand.Primary}"/>
                            <Setter TargetName="PART_Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Brand.Primary}"/>
                            <Setter TargetName="PART_Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Box" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Brand.Primary}"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════
         PROGRESSBAR
    ════════════════════════ -->
    <!-- Determinate (có %) -->
    <Style x:Key="Progress.Bar" TargetType="ProgressBar">
        <Setter Property="Height"               Value="6"/>
        <Setter Property="Background"           Value="{DynamicResource Brush.Background.Card}"/>
        <Setter Property="Foreground"           Value="{DynamicResource Brush.Brand.Primary}"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- Track (nền) -->
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"/>
                        <!-- Fill (phần đã hoàn thành) -->
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"/>
                        <!-- Indeterminate animation -->
                        <Border x:Name="PART_GlowRect"
                                Visibility="Collapsed"
                                CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#5B6CF9" Offset="0.4"/>
                                    <GradientStop Color="#7C8DFF" Offset="0.6"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="AnimTransform" X="-200"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation
                                                Storyboard.TargetName="AnimTransform"
                                                Storyboard.TargetProperty="X"
                                                From="-200" To="400"
                                                Duration="0:0:1.4"
                                                EasingFunction="{x:Null}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_GlowRect" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Override ProgressBar mặc định nếu muốn áp global -->
    <Style TargetType="ProgressBar" BasedOn="{StaticResource Progress.Bar}"/>

    <!-- ════════════════════════
         SEPARATOR (Đường phân cách)
    ════════════════════════ -->
    <Style x:Key="UI.Separator" TargetType="Separator">
        <Setter Property="Background"       Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="Height"           Value="1"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Margin"           Value="0,8"/>
    </Style>

    <!-- ════════════════════════
         SCROLLBAR (Mỏng, hiện đại)
         Áp dụng global lên toàn app
    ════════════════════════ -->
    <Style x:Key="ScrollBar.Thin" TargetType="ScrollBar">
        <Setter Property="Background"   Value="{DynamicResource Brush.ScrollBar.Track}"/>
        <Setter Property="Width"        Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Background="Transparent" BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Background="{DynamicResource Brush.ScrollBar.Thumb}"
                                                    CornerRadius="3"
                                                    Margin="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background"
                                                            Value="{DynamicResource Brush.ScrollBar.ThumbHover}"/>
                                                    <Setter TargetName="ThumbBorder" Property="Margin" Value="0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Background="Transparent" BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Override global ScrollBar -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBar.Thin}"/>

</ResourceDictionary>
