<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- CHỮ VIẾT & KIỂU DÁNG File: Assets/Styles/Typography.xaml Mô tả: Style cho TextBlock theo v... -->

    <!-- Font gia đình mặc định toàn app. Segoe UI Variable là font hiện đại của Windows 11, rất đẹ... -->
    <FontFamily x:Key="Font.Default">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <!-- Font cho số, bảng dữ liệu - có chữ số cùng độ rộng. -->
    <FontFamily x:Key="Font.Mono">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- CỠ CHỮ (Font Size Scale). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Display">36</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.H1">28</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.H2">22</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.H3">18</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Body">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.BodySm">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Label">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Caption">11</sys:Double>

    <!-- BASE STYLE Áp lên toàn bộ TextBlock trong app (đặt trong App.xaml Resources với BasedOn). -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{StaticResource Font.Default}"/>
        <Setter Property="FontSize"     Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="LineHeight"   Value="22"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- DISPLAY (Hero, Banner). -->
    <!-- Dùng cho tiêu đề lớn nhất, thường 1 dòng ngắn. -->
    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.Display}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="LineHeight"   Value="44"/>
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Primary}"/>
    </Style>

    <!-- Display với màu accent (thường dùng highlight từ quan trọng). -->
    <Style x:Key="Text.Display.Accent" TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Brand.Accent}"/>
    </Style>

    <!-- HEADINGS (H1 → H3). -->
    <!-- H1: Tiêu đề trang / section lớn. -->
    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.H1}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="LineHeight"   Value="36"/>
    </Style>

    <!-- H2: Tiêu đề nhóm nội dung. -->
    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.H2}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="LineHeight"   Value="30"/>
    </Style>

    <!-- H3: Tiêu đề card / widget nhỏ. -->
    <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.H3}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="LineHeight"   Value="26"/>
    </Style>

    <!-- BODY (Nội dung chính). -->
    <!-- Body thông thường. -->
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>

    <!-- Body phụ, ít quan trọng hơn. -->
    <Style x:Key="Text.Body.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Secondary}"/>
    </Style>

    <!-- Body mờ, mô tả phụ. -->
    <Style x:Key="Text.Body.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Muted}"/>
    </Style>

    <!-- Body nhỏ hơn (13px). -->
    <Style x:Key="Text.Body.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.BodySm}"/>
    </Style>

    <!-- LABEL (Nhãn form/input). -->
    <!-- Nhãn trên TextBox, ComboBox. -->
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.Label}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Margin"       Value="0,0,0,4"/>
    </Style>

    <!-- Nhãn lỗi validation màu đỏ. -->
    <Style x:Key="Text.Label.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Status.Error}"/>
        <Setter Property="FontWeight"   Value="Normal"/>
        <Setter Property="Margin"       Value="0,4,0,0"/>
    </Style>

    <!-- CAPTION (Chú thích nhỏ). -->
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize"     Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Muted}"/>
        <Setter Property="LineHeight"   Value="16"/>
    </Style>

    <!-- CODE (Hiển thị kỹ thuật). -->
    <Style x:Key="Text.Code" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily"   Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize"     Value="{StaticResource FontSize.BodySm}"/>
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Brand.Accent}"/>
        <Setter Property="Background"   Value="{DynamicResource Brush.Background.Card}"/>
    </Style>

    <!-- APPBAR (Riêng cho Header/Footer) Dùng màu OnPrimary để nổi trên nền AppBar. -->
    <Style x:Key="AppBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground"   Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
