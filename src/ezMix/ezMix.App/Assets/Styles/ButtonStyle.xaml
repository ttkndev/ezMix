<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Brand.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Accent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
